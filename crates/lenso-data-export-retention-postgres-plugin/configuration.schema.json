{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "database_url_secret",
    "export_callers",
    "retention_callers",
    "max_sources",
    "max_participants",
    "max_items",
    "max_item_bytes",
    "max_total_bytes"
  ],
  "properties": {
    "schema": { "type": "string" },
    "database_url_secret": { "type": "string" },
    "export_callers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "retention_callers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "max_sources": { "type": "integer", "minimum": 1, "maximum": 64 },
    "max_participants": { "type": "integer", "minimum": 1, "maximum": 64 },
    "max_items": { "type": "integer", "minimum": 1, "maximum": 512 },
    "max_item_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "max_total_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
  },
  "additionalProperties": false
}
